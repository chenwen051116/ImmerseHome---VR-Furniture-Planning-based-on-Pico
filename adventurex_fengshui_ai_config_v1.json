{
  "package_name": "AdventureX_AI_国学空间顾问",
  "version": "1.0.0",
  "language": "zh-CN",
  "purpose": "用于户型与家具布局原型中的风水文化分析、解释、评分和可执行优化建议。",
  "important_scope": {
    "definition_of_guoxue_in_this_project": "本项目中的“国学”仅指中国传统宅居文化、空间礼序、形势关系、阴阳平衡与居住心理偏好，不等同于全部国学，也不包含未经用户明确选择的八字、命卦、择日或宿命预测。",
    "product_positioning": "传统居住文化辅助决策系统，而非算命、医疗、法律或工程验收系统。",
    "core_goal": "在安全合规、结构可行、生活功能、用户偏好、传统空间文化与审美之间寻找综合最优解。",
    "non_goals": [
      "不得预测财富、婚姻、健康、寿命、事业成败等现实结果。",
      "不得把传统文化判断描述为科学定律或强制工程规范。",
      "不得在缺少朝向、尺寸、门窗、家具坐标时编造信息。",
      "不得建议拆改承重结构、消防设施、公共管线或其他不可变构件。"
    ]
  },
  "recommended_architecture": {
    "principle": "几何关系由程序计算，大模型负责综合解释、权衡、推荐与自然语言表达。",
    "pipeline": [
      {
        "step": 1,
        "name": "空间数据标准化",
        "description": "将户型、门窗、房间、家具、朝向和用户偏好转换为结构化数据。"
      },
      {
        "step": 2,
        "name": "几何关系预计算",
        "description": "程序计算相对位置、距离、视线、门扇碰撞、通道宽度、窗户遮挡、家具与梁柱重叠等事实。"
      },
      {
        "step": 3,
        "name": "规则匹配",
        "description": "使用 rule_library 对事实进行 pass、warning、fail、unknown 判定。"
      },
      {
        "step": 4,
        "name": "大模型综合分析",
        "description": "模型引用规则依据，结合用户风水重视程度、家庭成员、风格与预算输出解释和多套调整方案。"
      },
      {
        "step": 5,
        "name": "方案更新与重新评分",
        "description": "用户移动或更换家具后重新运行几何检测与评分，不沿用旧结论。"
      }
    ]
  },
  "evidence_hierarchy": [
    {
      "level": "A",
      "name": "国家强制性工程建设规范",
      "authority": "最高",
      "usage": "用于安全、基本功能、通行、采光、通风等底线判断；不得被风水偏好覆盖。"
    },
    {
      "level": "B",
      "name": "现代空间设计与人体工学原则",
      "authority": "高",
      "usage": "用于动线、尺度、私密、操作便利、视觉舒适与长期使用体验。"
    },
    {
      "level": "C",
      "name": "中国传统宅居文化与形势派原则",
      "authority": "文化性",
      "usage": "用于解释中国用户的居住心理与文化偏好，必须同时给出现代空间解释，不得宣称科学因果。"
    },
    {
      "level": "D",
      "name": "项目计算启发式阈值",
      "authority": "工程实现约定",
      "usage": "用于自动检测，必须标注为可配置项目阈值，不得冒充国家标准或古籍原文。"
    }
  ],
  "reference_sources": [
    {
      "source_id": "GB55038_2025",
      "title": "《住宅项目规范》GB 55038-2025",
      "source_type": "国家强制性工程建设规范",
      "status": "2025-05-01起实施",
      "relevant_clauses": [
        {
          "clause": "2.2.7",
          "meaning": "住宅建筑应满足居住所需的通风、日照、采光、隔声、防水、防潮、保温和隔热等性能要求。"
        },
        {
          "clause": "4.1.13",
          "meaning": "套内入口过道净宽不应小于1.10m；通往卧室、起居室的过道不应小于1.00m；通往厨房、卫生间、贮藏室的过道不应小于0.90m。"
        },
        {
          "clause": "4.1.14",
          "meaning": "对户门、卧室门、厨房门和卫生间门的通行净宽提出底线要求。"
        },
        {
          "clause": "6.2.1",
          "meaning": "每套住宅至少有一个卧室或起居室满足日照标准。"
        },
        {
          "clause": "6.2.2",
          "meaning": "卧室、起居室和厨房均应有直接采光。"
        },
        {
          "clause": "6.3.3",
          "meaning": "住宅应满足自然通风开口要求，卧室、起居室和厨房应能自然通风。"
        }
      ],
      "usage_limit": "原型可据此进行辅助提醒，但不能替代注册建筑师、室内设计师或施工图审查。"
    },
    {
      "source_id": "GB55019_2021",
      "title": "《建筑与市政工程无障碍通用规范》GB 55019-2021",
      "source_type": "国家强制性工程建设规范",
      "status": "2022-04-01起实施",
      "relevant_topics": [
        "无障碍通行",
        "安全使用",
        "老年人、儿童及行动不便者的空间可达性"
      ],
      "usage_limit": "只有在输入包含老人、轮椅使用者、行动不便者等人群时，才提高无障碍权重；具体施工仍需查验完整现行规范。"
    },
    {
      "source_id": "HUANGDI_ZHAIJING",
      "title": "《黄帝宅经》",
      "source_type": "传统宅居文化文献",
      "evidence_level": "C",
      "short_excerpt": "故宅者，人之本。人以宅为家，居若安……",
      "project_interpretation": "住宅首先应使人安定、舒适、可居；在本项目中转化为安全感、私密性、秩序感、采光通风、动线与尺度协调。",
      "usage_limit": "仅作为文化解释来源，不作为科学证明或工程强制标准；不使用吉凶宿命式结论。"
    },
    {
      "source_id": "FORM_SCHOOL_GENERAL",
      "title": "形势派宅居空间常用原则",
      "source_type": "传统文化规则集合",
      "evidence_level": "C",
      "core_concepts": [
        {
          "concept": "有靠",
          "project_interpretation": "主要长期停留位背后有稳定实体界面，减少背后穿行、突发干扰和漂浮感。"
        },
        {
          "concept": "藏风聚气",
          "project_interpretation": "避免入口、核心活动区和外部开口形成毫无遮挡的强直线关系；兼顾隐私、视线缓冲和空间层次。"
        },
        {
          "concept": "明堂开阔",
          "project_interpretation": "客厅、入户缓冲区或主要活动区应保持适当开敞、清晰和明亮，避免家具过密。"
        },
        {
          "concept": "动静有序",
          "project_interpretation": "会客、通行、厨房等动态空间与睡眠、阅读等安静空间减少相互干扰。"
        },
        {
          "concept": "阴阳平衡",
          "project_interpretation": "在明暗、开合、动静、冷暖、实体与留白之间取得适度平衡，不机械套用方位吉凶。"
        }
      ],
      "usage_limit": "每次引用必须同时给出可观察的空间事实和现代设计解释。"
    }
  ],
  "conflict_resolution": {
    "priority_order": [
      "人身安全与强制规范",
      "结构、消防、门窗和固定管线等不可变约束",
      "基本功能、通行、采光、通风与无障碍",
      "用户明确需求与家庭成员特征",
      "传统宅居文化偏好",
      "风格与视觉美学"
    ],
    "rules": [
      "若风水建议与安全、消防、承重、通风或通行冲突，必须放弃风水建议。",
      "若传统文化规则与用户明确需求冲突，提供主方案和折中方案，不替用户做绝对决定。",
      "不得通过家具遮挡消防、门窗、设备检修口或主要逃生通道。",
      "没有足够数据时返回 unknown，不得使用常识补全具体方位和尺寸。"
    ]
  },
  "project_detection_thresholds": {
    "note": "以下均为项目可配置启发式阈值，不是国家标准或古籍原文。",
    "direct_alignment_angle_deg": 15,
    "direct_alignment_max_distance_mm": 8000,
    "back_support_max_gap_mm": 300,
    "main_furniture_path_preferred_min_mm": 900,
    "secondary_furniture_path_preferred_min_mm": 750,
    "beam_overlap_warning_ratio": 0.2,
    "entrance_privacy_buffer_preferred_mm": 900,
    "furniture_window_blockage_warning_ratio": 0.25,
    "sharp_corner_target_angle_deg": 20
  },
  "rule_library": [
    {
      "rule_id": "FS-ENT-001",
      "name": "入户直见私密空间",
      "category": "传统文化+隐私",
      "applies_when": "入户门开启后，可无遮挡直视床、坐便器、淋浴区或卧室核心区域。",
      "geometry_detection": {
        "required_relations": [
          "entrance_door.line_of_sight",
          "private_object.visibility_ratio",
          "distance_mm"
        ],
        "default_condition": "visibility_ratio >= 0.5"
      },
      "cultural_basis": {
        "concept": "入户宜有缓冲、内外有序",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "降低隐私暴露，改善由公共到私密空间的过渡层次。",
      "severity": "high",
      "recommended_actions": [
        "调整床或卫生间可见面的朝向。",
        "增加不阻塞通道的玄关柜、格栅、屏风或半高隔断。",
        "无法遮挡时，利用转向、磨砂材质、帘体或局部视线屏蔽。"
      ]
    },
    {
      "rule_id": "FS-ENT-002",
      "name": "入户与阳台或大窗形成强直线贯通",
      "category": "传统文化+空间层次",
      "applies_when": "入户中心线与阳台门或大面积外窗近似共线，且中间缺少功能节点或视觉缓冲。",
      "geometry_detection": {
        "required_relations": [
          "entrance_to_exterior_opening.angle_deg",
          "line_of_sight_clear",
          "distance_mm"
        ],
        "default_condition": "angle_deg <= 15 and line_of_sight_clear == true"
      },
      "cultural_basis": {
        "concept": "藏风聚气",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "改善入户第一视角、隐私、空间停顿和层次；同时避免把所有视觉注意力立即拉向单一出口。",
      "severity": "medium",
      "recommended_actions": [
        "设置通透但有层次的玄关节点。",
        "用沙发、地毯、边柜或灯光形成视觉停顿，不应堵塞主通道。",
        "若空间狭小，只做低干预软装缓冲，不强行封闭。"
      ]
    },
    {
      "rule_id": "FS-SEAT-001",
      "name": "沙发或主要座位背后无靠",
      "category": "传统文化+安全感",
      "applies_when": "沙发主座背后为主要通道、门、落地窗或大面积空区，且距离稳定实体界面超过项目阈值。",
      "geometry_detection": {
        "required_relations": [
          "seat.back_to_solid_surface_distance_mm",
          "backside_traffic_frequency",
          "backside_opening_type"
        ],
        "default_condition": "distance_mm > 300 or backside_traffic_frequency == 'high'"
      },
      "cultural_basis": {
        "concept": "有靠",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "减少背后频繁穿行和突发干扰，提升主座稳定感，同时便于形成明确会客中心。",
      "severity": "medium",
      "recommended_actions": [
        "优先让沙发靠实体墙或稳定柜体。",
        "无法靠墙时，在背后设置窄边柜、矮柜或低密度屏风形成心理边界。",
        "不得为了“有靠”压缩主要通道至不合理宽度。"
      ]
    },
    {
      "rule_id": "FS-BED-001",
      "name": "床头缺少稳定支撑",
      "category": "传统文化+睡眠空间",
      "applies_when": "床头位于窗下、门洞处、主要通道侧或远离稳定墙体。",
      "geometry_detection": {
        "required_relations": [
          "bed.head_to_solid_wall_distance_mm",
          "bed.head_overlaps_window",
          "traffic_behind_head"
        ],
        "default_condition": "head_to_solid_wall_distance_mm > 300 or bed.head_overlaps_window == true"
      },
      "cultural_basis": {
        "concept": "床头有靠",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "减少头部后方的光、风、噪声和人员走动干扰，增强休息区稳定性。",
      "severity": "high",
      "recommended_actions": [
        "将床头调整至完整实体墙。",
        "无法移动时，增加稳固高靠背并优化遮光、隔音与窗帘。",
        "不可遮挡必要窗扇开启和自然通风。"
      ]
    },
    {
      "rule_id": "FS-BED-002",
      "name": "床与房门正对",
      "category": "传统文化+私密",
      "applies_when": "房门开启视线与床中心或床头区域近似共线，且床大面积暴露。",
      "geometry_detection": {
        "required_relations": [
          "door_to_bed.angle_deg",
          "bed.visibility_ratio_from_door",
          "distance_mm"
        ],
        "default_condition": "angle_deg <= 15 and visibility_ratio >= 0.5"
      },
      "cultural_basis": {
        "concept": "门床避免直冲",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "降低开门瞬间的视线暴露和惊扰，提升卧室私密与心理安全。",
      "severity": "high",
      "recommended_actions": [
        "优先旋转或横移床位，避免床头和床中心处于门的直线视域。",
        "空间不足时，用床尾凳、低柜或局部隔断形成缓冲。",
        "不得因调整造成衣柜无法开启或通道不足。"
      ]
    },
    {
      "rule_id": "FS-BED-003",
      "name": "床或长期座位受梁体压迫",
      "category": "传统文化+视觉舒适",
      "applies_when": "可见梁体在水平投影上明显覆盖床、沙发主座或书桌长期停留区。",
      "geometry_detection": {
        "required_relations": [
          "beam_overlap_ratio",
          "beam_bottom_height_mm",
          "occupancy_duration"
        ],
        "default_condition": "beam_overlap_ratio >= 0.2 and occupancy_duration == 'long'"
      },
      "cultural_basis": {
        "concept": "避免梁压",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "避免头顶局部压低形成明显压迫感；低净高还可能影响灯光与活动舒适度。",
      "severity": "medium",
      "recommended_actions": [
        "移动床、沙发或书桌，使长期停留区避开梁体投影。",
        "无法移动时，用整体平顶、灯光和色彩弱化高差，但不得违规改动结构。",
        "若净高不确定，结论标记为 unknown 并请求尺寸。"
      ]
    },
    {
      "rule_id": "FS-MIR-001",
      "name": "镜面直接映照床或入户核心视线",
      "category": "传统文化+视觉干扰",
      "applies_when": "用户躺卧或进入空间时，镜面能直接映出床或产生强烈人影反射。",
      "geometry_detection": {
        "required_relations": [
          "mirror_visible_from_bed_eye_points",
          "mirror_visible_from_entrance",
          "mirror_area_m2"
        ],
        "default_condition": "mirror_visible_from_bed_eye_points == true"
      },
      "cultural_basis": {
        "concept": "镜面宜谨慎设置",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "夜间、弱光或突然进入空间时，大面积动态反射可能造成视觉干扰；同时影响卧室安静感。",
      "severity": "low",
      "recommended_actions": [
        "改变镜面角度或移至柜门内侧。",
        "使用可关闭镜门、帘体或低反射材质。",
        "用户不在意时可降低权重，不作为硬性否决项。"
      ]
    },
    {
      "rule_id": "FS-DESK-001",
      "name": "书桌背门或背后为高频通道",
      "category": "传统文化+专注体验",
      "applies_when": "坐姿朝向使使用者完全背对房门，且背后存在高频人员通行。",
      "geometry_detection": {
        "required_relations": [
          "desk_user_facing_vector",
          "door_position",
          "backside_traffic_frequency"
        ],
        "default_condition": "door_is_behind_user == true and backside_traffic_frequency == 'high'"
      },
      "cultural_basis": {
        "concept": "坐位有靠、可知来向",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "减少背后走动带来的分心和突发惊扰，同时兼顾屏幕隐私。",
      "severity": "medium",
      "recommended_actions": [
        "调整桌面方向，使门位于侧前方可感知范围。",
        "无法改变方向时，增加低矮边界或减少背后通行。",
        "优先保证自然光不直射屏幕和正常座椅后退空间。"
      ]
    },
    {
      "rule_id": "FS-KIT-001",
      "name": "灶台与水槽关系不协调",
      "category": "传统文化+厨房操作",
      "applies_when": "灶台与水槽过近、直接相对，或操作时存在水汽、热源、转身和碰撞干扰。",
      "geometry_detection": {
        "required_relations": [
          "stove_to_sink_distance_mm",
          "stove_sink_relative_orientation",
          "counter_continuity",
          "aisle_width_mm"
        ],
        "default_condition": "distance_mm is not null and distance_mm < project_config.kitchen_stove_sink_preferred_distance_mm"
      },
      "cultural_basis": {
        "concept": "水火关系协调",
        "source_ids": [
          "FORM_SCHOOL_GENERAL"
        ]
      },
      "modern_basis": "减少水汽与明火、电器、热锅操作相互干扰，改善备餐流程和操作安全。",
      "severity": "medium",
      "recommended_actions": [
        "在水槽与灶台之间保留连续备餐台面。",
        "避免灶台与水槽在狭窄通道两侧正面对冲。",
        "具体安全距离应根据设备说明、燃气规范和项目设计确定，模型不得编造强制数值。"
      ]
    },
    {
      "rule_id": "FS-BATH-001",
      "name": "卫生间门直对入户、餐桌或床",
      "category": "传统文化+卫生私密",
      "applies_when": "卫生间门开启后直接进入入户、餐桌或床的主要视线。",
      "geometry_detection": {
        "required_relations": [
          "bathroom_door_line_of_sight",
          "target_visibility_ratio",
          "distance_mm"
        ],
        "default_condition": "target_visibility_ratio >= 0.5"
      },
      "cultural_basis": {
