      },
      "reference_basis": {
        "source_ids": [
          "GB55038_2025"
        ],
        "clauses": [
          "4.1.13",
          "4.1.14"
        ]
      },
      "modern_basis": "保证基本通行、搬运、日常使用和紧急情况下的可达性。",
      "severity": "critical",
      "recommended_actions": [
        "缩小、替换或移动造成阻挡的家具。",
        "检查柜门、房门、抽屉和椅子使用状态下的动态占用。",
        "固定套内过道按适用国家规范判断；家具间净距使用项目偏好值时必须注明是启发式。"
      ]
    },
    {
      "rule_id": "FS-LIGHT-001",
      "name": "家具遮挡直接采光",
      "category": "强制规范+舒适",
      "applies_when": "高柜、隔断或大型家具明显遮挡卧室、起居室或厨房的主要采光窗。",
      "geometry_detection": {
        "required_relations": [
