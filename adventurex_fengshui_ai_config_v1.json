        "户型无法改变时，通过柜体、格栅或绿植弱化直接视线。"
      ]
    },
    {
      "rule_id": "FS-CIR-001",
      "name": "主要通行受阻",
      "category": "强制规范+功能",
      "applies_when": "固定过道或家具布置后的主要路径净宽不足、门扇碰撞或存在死角。",
      "geometry_detection": {
        "required_relations": [
          "path_clear_width_mm",
          "path_type",
          "door_swing_collision",
